// Prisma schema — QR注文・店舗管理アプリ
//
// migrations ディレクトリを持たず、デプロイのたびに `prisma db push` でこの
// スキーマをそのまま反映する運用（package.json の vercel-build 参照）。

generator client {
  provider = "prisma-client-js"
}

// Prisma ORM 7 では datasource に url を書かず、接続文字列は
// prisma.config.ts（CLI用）と src/lib/prisma.ts（実行時のドライバアダプタ）
//側で環境変数から解決する。
datasource db {
  provider = "postgresql"
}

model StaffUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

// 店舗全体の設定を1行だけ持つシングルトンテーブル。
model Settings {
  id             String   @id @default("singleton")
  restaurantName String   @default("Chil Terrace")
  // "table"（席を作って卓ごとに注文を受け取る） | "number"（フリー席・注文番号を発行する）
  operationMode  String   @default("table")
  updatedAt      DateTime @updatedAt
}

model RestaurantTable {
  id        String   @id @default(cuid())
  number    Int      @unique
  name      String?
  createdAt DateTime @default(now())

  orders   Order[]
  sessions TableSession[]
}

model Category {
  id        String @id @default(cuid())
  name      String
  sortOrder Int    @default(0)

  menuItems MenuItem[]
}

model MenuItem {
  id            String   @id @default(cuid())
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  name          String
  price         Int
  description   String?
  isRecommended Boolean  @default(false)
  isAvailable   Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  orderItems OrderItem[]
}

// 卓の会計セッション（卓方式のみで使用）。QRから注文を始めてから会計するまでの
// 一続きをまとめる。同じ卓で複数人が別々に注文しても、進行中のセッションが
// あればそこに注文が積み重なる。
model TableSession {
  id        String    @id @default(cuid())
  tableId   String
  table     RestaurantTable @relation(fields: [tableId], references: [id])
  startedAt DateTime  @default(now())
  closedAt  DateTime?

  orders Order[]

  @@index([tableId, closedAt])
}

// 注文番号方式で使う、日付ごとの通し番号カウンタ。JSTの日付文字列
// （例: "2026-08-21"）をキーにして、日が変わったら1から採番し直す。
model OrderCounter {
  dateKey String @id
  count   Int    @default(0)
}

model Order {
  id        String   @id @default(cuid())
  // 注文発生時点の運用モードを記録する（"table" | "number"）。設定を後で
  // 変更しても過去の注文の扱いが変わらないようにするため。
  mode      String
  tableId   String?
  table     RestaurantTable? @relation(fields: [tableId], references: [id])
  sessionId String?
  session   TableSession?    @relation(fields: [sessionId], references: [id])
  // 注文番号方式のみで使用（卓方式ではnull）
  dailyNumber Int?
  // pending(受付) -> preparing(調理中) -> served(提供済み/受け渡し済み) ->
  // paid(会計済み、卓方式のみ) / cancelled(取消、いつでも遷移しうる)
  status    String   @default("pending")
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]

  @@index([status, createdAt])
  @@index([mode, dailyNumber])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  // 注文時点の名前・単価のスナップショット（後でメニュー価格を変更しても過去の
  // 注文金額が変わらないようにするため）
  name       String
  price      Int
  quantity   Int
}
