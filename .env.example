# Postgres接続文字列。Vercelダッシュボードの Project Settings > Environment
# Variables で、Postgresインテグレーション（Prisma Postgres / Vercel Postgres
# など）を接続すると自動的に設定される。src/lib/env.ts が複数の命名パターンに
# フォールバック対応しているため、実際に払い出された変数名だけ設定すればよい。
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth (Auth.js) のセッション暗号化用シークレット。
# 生成方法: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"

# デプロイ時（prisma/seed.ts）に作成される、店舗スタッフ用ログインアカウント。
STAFF_EMAIL="staff@example.com"
STAFF_PASSWORD="replace-with-a-strong-password"

# 表示店舗名（サイドバーやタイトルに表示）。
NEXT_PUBLIC_RESTAURANT_NAME="Chil Terrace"

# 初期投入するテーブル数（卓1〜卓Nを作成）。
TABLE_COUNT="8"
